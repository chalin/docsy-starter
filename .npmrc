# npm supply-chain controls; rationale:
# https://opentelemetry.io/site/design/supply-chain-security/

min-release-age=7
strict-allow-scripts=true
engine-strict=true

# Execution default-deny; scripts are hook-free (tests/npm-scripts.test.mjs),
# and install:safe surgically re-enables hugo-extended's binary download.
ignore-scripts=true
