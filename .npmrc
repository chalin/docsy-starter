# npm supply-chain gates.

# The npm engines floor (package.json) is the version where the allowScripts
# policy landed; on older npm the key is silently ignored, an unprotected
# install that looks protected. engine-strict turns that floor into a hard
# install-time failure.
engine-strict=true
strict-allow-scripts=true

# Cooldown: refuse packages published less than 7 days ago.
min-release-age=7

# Execution default-deny everywhere this repo installs (CI, Netlify,
# contributors). Package scripts are hook-free, so no npm run chain relies on
# pre/post hooks; install:safe re-enables hugo-extended's binary download
# surgically (npm rebuild --ignore-scripts=false).
ignore-scripts=true
